# Copy to .env for local development. On a hosting platform, set these as
# environment variables instead; most platforms set PORT themselves.

PORT=8080
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API and open the WebSocket.
# Add https://<your-lan-ip>:3000 to test from a phone on the same Wi-Fi.
ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000

# Local HTTPS, only needed to test from a phone on the LAN (run `npm run certs`
# first, then set both to ../certs/cert.pem and ../certs/key.pem).
# Leave empty on your laptop (localhost is already a secure context) and in
# production, where the platform terminates TLS.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Instant meetings: lifetime after creation, and how long an emptied room
# stays joinable. Durations accept ms, s, m, h (for example 1h30m).
INSTANT_ROOM_TTL=12h
INSTANT_ROOM_EMPTY_GRACE=30m

# Cloudflare Realtime. Not needed until Phase 3 (TURN) and Phase 4 (SFU).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
CF_CALLS_APP_ID=
CF_CALLS_APP_TOKEN=
