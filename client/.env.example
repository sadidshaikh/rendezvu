# Copy to .env.local for local overrides. Production values are set on the
# hosting platform at build time.

# host[:port] of the signaling server. Leave unset in development to use the
# page's own host on port 8080, which also works from a phone on the LAN.
# VITE_SERVER_DOMAIN=localhost:8080

# "true" for https/wss. Unset in development: follows the page's protocol.
# VITE_SERVER_SECURE=true
