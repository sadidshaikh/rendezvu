{
  "name": "rendezvu",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "signaling",
    "client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n signaling,client -c blue,magenta \"npm run dev -w signaling\" \"npm run dev -w client\"",
    "certs": "node scripts/generate-cert.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
